{
  "extensions": [
    {
      "id": "hermes-one-extension-kit",
      "name": "Hermes One Extension Kit",
      "scripts": [
        "hermes-one-extension-kit/hermes-theme-bridge.js",
        "hermes-one-extension-kit/hermes-panel-nav.js"
      ],
      "stylesheets": [
        "hermes-one-extension-kit/hermes-panel.css"
      ]
    },
    {
      "id": "hermes-one-office-3d",
      "name": "Office 3D",
      "scripts": [
        "hermes-one-office-3d/office-nav.js"
      ],
      "stylesheets": [
        "hermes-one-office-3d/office-nav.css"
      ]
    },
    {
      "id": "hermes-one-capability-router",
      "name": "Capability Router",
      "scripts": [
        "hermes-one-capability-router/router-nav.js"
      ],
      "stylesheets": [
        "hermes-one-capability-router/router-nav.css"
      ],
      "sidecar": {
        "type": "loopback",
        "origin": "http://127.0.0.1:8791",
        "health_path": "/health",
        "proxy_auth": "token-v1"
      }
    },
    {
      "id": "hermes-one-fact-explorer",
      "name": "Fact Explorer",
      "scripts": [
        "hermes-one-fact-explorer/memory-nav.js"
      ],
      "stylesheets": [
        "hermes-one-fact-explorer/memory-nav.css"
      ],
      "sidecar": {
        "type": "loopback",
        "origin": "http://127.0.0.1:8792",
        "health_path": "/health",
        "proxy_auth": "token-v1"
      }
    }
  ]
}
